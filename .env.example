# Copy this file to .env.local for local development (.env.local is
# git-ignored). Never commit real values.
#
# Both variables below are PUBLIC values by design: the Supabase "anon" key
# is meant to ship in client bundles and is only ever as powerful as your
# Row Level Security policies allow (see docs/SECURITY.md). Do NOT put the
# service-role key here or anywhere under src/ - it belongs exclusively in
# Supabase Edge Function secrets (see README.md "Umgebungsvariablen & Secrets").

# Project Settings -> API -> Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Project Settings -> API -> Project API keys -> anon / public
VITE_SUPABASE_ANON_KEY=your-anon-key
